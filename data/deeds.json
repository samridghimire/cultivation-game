    {"id": "ma_snare_line", "hint": "check his snare line", "name": "Help Hunter Ma check his snare line", "context": "hunter_ma_errand", "days": 2, "once": true, "blocked_by_flag": "ma_snare_done", "favor": {"hunter_ma": 12}, "effects": {"witnessed": true, "alignment": 3, "items": {"venison": 1}, "set_flag": "ma_snare_done"}, "result": "Hm. Two hares, one fox track. You walk quiet. Take the meat."},
    {"id": "ling_water_rounds", "hint": "carry water on her rounds", "name": "Help Xiao Ling on her water rounds", "context": "xiao_ling_errand", "days": 1, "once": true, "blocked_by_flag": "ling_rounds_done", "favor": {"xiao_ling": 10}, "effects": {"witnessed": true, "alignment": 3, "items": {"sweet_rice_ball": 2}, "set_flag": "ling_rounds_done"}, "result": "You are slow, but you did not spill. Grandmother says that counts double! Here, the dumplings are for you. Do not tell her I said so."},
    {"id": "hei_bail_skiff", "hint": "bail out his leaking skiff", "name": "Bail out Peddler Hei's leaking skiff", "context": "marsh_captive", "days": 1, "once": true, "blocked_by_flag": "hei_bail_done", "favor": {"peddler_hei": 12}, "effects": {"items": {"rain_cap_mushroom": 2}, "set_flag": "hei_bail_done"}, "result": "Ehe. Dry boards, no complaints. Most folk hold their noses. Take these, they grow where the dead are kind."},
    {"id": "bai_sweep_terraces", "hint": "sweep her terraces", "name": "Sweep the fallen leaves from Bai's terraces", "context": "bai_errand", "days": 1, "once": true, "blocked_by_flag": "bai_sweep_done", "favor": {"disciple_bai": 12}, "effects": {"witnessed": true, "alignment": 3, "items": {"spirit_herb": 1}, "set_flag": "bai_sweep_done"}, "result": "The terraces are tidy. My senior will think I did it, and I will not correct her. Take these, quietly."},
    {"id": "ye_tend_drying_rack", "hint": "turn the herbs on her racks", "name": "Turn the herbs on Ye's drying racks", "context": "ye_errand", "days": 2, "once": true, "blocked_by_flag": "ye_racks_done", "favor": {"alchemist_ye": 12}, "effects": {"witnessed": true, "alignment": 3, "items": {"frostbell_herb": 2}, "set_flag": "ye_racks_done"}, "result": "Not bad. You did not crush a single leaf. Frostbell keeps well: take it, and do not ask me what it is for."},
    {"id": "qian_count_stock", "hint": "count his storehouse stock", "name": "Count Qian's stock in the market storehouse", "context": "qian_errand", "days": 1, "once": true, "blocked_by_flag": "qian_stock_done", "favor": {"broker_qian": 12}, "effects": {"items": {"talisman_paper": 2}, "set_flag": "qian_stock_done"}, "result": "Your count is off by one jar. Mine was off by two, so we are even. Take the paper; I never gave it to you."},
